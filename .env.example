# Copy to .env, fill the secrets, and run: chmod 600 .env
VLLM_API_KEY=
HF_TOKEN=
HF_ENDPOINT=https://hf-mirror.com

# Optional gateway overrides; defaults are shown.
# VLLM_GATEWAY_UPSTREAM_URL=http://127.0.0.1:8010
# VLLM_GATEWAY_MAX_CONCURRENCY=32
# VLLM_GATEWAY_MAX_QUEUE=32
# VLLM_GATEWAY_QUEUE_TIMEOUT_SECONDS=300
# VLLM_GATEWAY_READ_TIMEOUT_SECONDS=3600

# Optional overrides for the backend readiness gate that holds vllm.service in
# activating until the engine serves.
# VLLM_READY_URL=http://127.0.0.1:8010/health
# VLLM_READY_INTERVAL_SECONDS=5

# Optional watchdog overrides; full probe URLs are expected.
# VLLM_WATCHDOG_UPSTREAM_URL=http://127.0.0.1:8010/health
# VLLM_WATCHDOG_GATEWAY_URL=http://127.0.0.1:8011/health/live
# VLLM_WATCHDOG_BACKEND_UNIT=vllm.service
# VLLM_WATCHDOG_GATEWAY_UNIT=vllm-gateway.service
# VLLM_WATCHDOG_BACKEND_THRESHOLD=3
# VLLM_WATCHDOG_GATEWAY_THRESHOLD=3
